# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docuchat
DB_USER=docuchat
DB_PASSWORD=docuchat_dev_password

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod-32c
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration (for job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Provider Configuration
AI_PROVIDER=mock
# Options: mock, openai, anthropic. In production the app refuses to start if the
# chosen provider has no API key; outside production it falls back to mock.

# Embeddings are chosen separately (Anthropic has no embeddings API).
# auto = follow AI_PROVIDER; with anthropic, auto uses OpenAI if OPENAI_API_KEY is set.
# Changing the embedding model means re-embedding all documents.
EMBEDDING_PROVIDER=auto
# Options: auto, openai, mock

# Optional fallback for completions when the primary is down (429/5xx/timeout after retries).
# Never used for auth errors, never used for embeddings. 'mock' is not allowed.
AI_FALLBACK_PROVIDER=none
# Options: none, openai, anthropic

# Retries use exponential backoff with jitter and honour Retry-After
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
AI_TIMEOUT_MS=30000

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration (if using anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave unset for current Claude models: the API rejects the temperature parameter (HTTP 400).
# ANTHROPIC_TEMPERATURE=0.3

# AI Limits
MAX_TOKENS_PER_REQUEST=4096
MAX_DOCUMENT_SIZE_MB=10
MAX_CHUNKS_PER_QUERY=5
EMBEDDING_DIMENSIONS=1536

# Prompts. Versions live in src/ai/prompts/templates.ts; an unknown version stops startup.
# Change a version only after the evals pass (docs/EVALUATION.md).
PROMPT_VERSION_CHAT=v3.0
PROMPT_VERSION_EXTRACT=v2.0

# Input safety. The detector only flags likely prompt injection (logs + usage metadata);
# it never blocks or rewrites. See docs/SECURITY.md.
MAX_QUESTION_CHARS=2000
INJECTION_DETECTION=true

# Conversation memory sent to the model: newest turns first, capped by characters
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_CHARS=4000
MIN_SIMILARITY_THRESHOLD=0.6
# Minimum similarity score for vector search (0-1)
# 0.6 is good for production quality. Use 0.0 for mock provider in testing.
USE_STRUCTURED_OUTPUT=true
# Use v2 structured JSON output for better citation parsing (recommended)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_CHAT_MAX=10
RATE_LIMIT_EXTRACT_MAX=5

# CORS
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
# Options: fatal, error, warn, info, debug, trace

# Cost control (docs/SECURITY.md). Limits are per user; 0 disables a limit.
# The budget is reserved atomically BEFORE each model call and corrected afterwards.
USER_DAILY_TOKEN_BUDGET=200000
USER_MONTHLY_COST_CAP_USD=5
# Prices in USD per 1M tokens, as JSON. Unknown models use the conservative fallback below
# (never zero). Copy the real prices from the provider's price page, e.g.:
# MODEL_PRICING_JSON={"your-model-name":{"input":1.0,"output":2.0}}   (example values, not real prices)
UNKNOWN_MODEL_PRICE_INPUT=10
UNKNOWN_MODEL_PRICE_OUTPUT=30

# Answer cache (Redis): per user, first turn only, short TTL
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300

# Rate limits (counters in Redis, shared by all API tasks; fail open if Redis is down)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
# Number of reverse proxies in front of the API (1 behind a single load balancer)
TRUST_PROXY=0
TOOLS_ENABLED=false   # read-only tool calling (get_document_info); not used on /chat/stream
TOOL_MAX_ROUNDS=2
MOCK_STREAM_DELAY_MS=2   # mock provider only: raise (e.g. 80) to watch streaming word by word

# Data protection (docs/AI-DATA.md)
# Mask emails, phones, card/national ids, IBANs and IPs in everything sent to an AI provider.
# Stored text and what the user sees stay as written. Costs some answer quality.
REDACT_PII_BEFORE_LLM=false
# Retention in days (daily job in the worker). 0 turns a rule off.
RETENTION_USAGE_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_BUDGET_DAYS=400
# Conversations are kept until the user deletes them; set a number of days to expire idle ones.
RETENTION_CONVERSATION_DAYS=0
# Debug aid: write plain JSON logs to this file instead of stdout
# LOG_FILE=/tmp/docuchat.log
