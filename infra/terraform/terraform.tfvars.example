# Copy to terraform.tfvars (ignored by git) and adjust.
# This file holds configuration only. There is intentionally nowhere to put a password or an API key:
# see infra/scripts/put-secret.sh and docs/DEPLOYMENT.md.

environment  = "prod"
project_name = "docuchat"
aws_region   = "us-east-1"

# Backend image with an immutable tag (the git SHA), pushed to your registry
app_image    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/docuchat-backend:REPLACE_WITH_GIT_SHA"
frontend_url = "https://app.example.com"

# Required in prod: HTTPS certificate from ACM
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"

ai_provider          = "anthropic" # or "openai"
ai_fallback_provider = "openai"    # "none" to disable

# Optional: alarms and a monthly AWS budget
alert_email        = "ops@example.com"
monthly_budget_usd = 150

# Optional non-secret application settings (budgets, prompt versions, retention...)
# app_environment = {
#   USER_DAILY_TOKEN_BUDGET = "200000"
# }
